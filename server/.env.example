# Copy to server/.env and fill in. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas dev database connection string (optional until we add models; see README "MongoDB setup")
MONGODB_URI=
# Optional: set if MongoDB fails with "querySrv ECONNREFUSED" (Node DNS issue on some Windows networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1
