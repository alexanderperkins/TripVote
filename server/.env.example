# Copy to server/.env and fill in. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string (see README "Getting started"). Sign up and log in need it.
MONGODB_URI=
# Secret for signing login tokens, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts, in seconds (default 1 day)
SESSION_TTL_SECONDS=86400
# Local development runs on http, so cookies can't be Secure. Use true (the default) in production.
COOKIE_SECURE=false
# Sign-up and log-in attempts allowed per IP address every 15 minutes
AUTH_RATE_LIMIT=20
# Optional: set if MongoDB fails with "querySrv ECONNREFUSED" (Node DNS issue on some Windows networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1
