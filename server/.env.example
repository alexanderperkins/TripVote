# Copy to server/.env and fill in. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas dev database connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tripvote-dev
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts, in seconds (default 1 day)
SESSION_TTL_SECONDS=86400
# Max sign-up/login attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Keep true. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
